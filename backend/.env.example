# Copy to backend/.env and fill in. Never commit the real .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DATABASE_URL=
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=
AURA_INSTANCENAME=

# Local development: python run.py binds 127.0.0.1 and permits local access.
# Deployment: set production + auth enabled and configure the publishable key.
APP_ENV=development
AUTH_ENABLED=false
# Password login (recommended for demos): every API call needs a signed-in session.
LOGIN_REQUIRED=true
ADMIN_USER_IDS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin alert e-mails: SMTP settings are set in the admin portal; only the password lives here.
SMTP_PASSWORD=
